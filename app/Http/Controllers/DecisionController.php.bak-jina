<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class DecisionController extends Controller
{
    public function index()
    {
        $rssUrl = 'https://putusan3.mahkamahagung.go.id/rss.html';
        $decisions = [];
        $errorMsg = null;
        try {
            $ctx = stream_context_create(['http'=>['header'=>"User-Agent: Mozilla/5.0\r\nAccept: application/rss+xml\r\n",'timeout'=>12]]);
            $body = @file_get_contents($rssUrl, false, $ctx);
            if ($body && strlen($body) > 200) {
                libxml_use_internal_errors(true);
                $xml = simplexml_load_string($body);
                if ($xml && isset($xml->channel->item)) {
                    foreach ($xml->channel->item as $item) {
                        $decisions[] = [
                            'title' => (string)($item->title ?? ''),
                            'link' => (string)($item->link ?? ''),
                            'pubDate' => (string)($item->pubDate ?? ''),
                            'description' => (string)($item->description ?? ''),
                        ];
                    }
                } else {
                    $errorMsg = 'Format RSS tidak dikenali.';
                }
            } else {
                $errorMsg = 'Feed tidak merespon (mungkin diblokir Cloudflare).';
            }
        } catch (\Exception $e) {
            $errorMsg = $e->getMessage();
        }
        return view('decision.index', compact('decisions','errorMsg','rssUrl'));
    }
}
